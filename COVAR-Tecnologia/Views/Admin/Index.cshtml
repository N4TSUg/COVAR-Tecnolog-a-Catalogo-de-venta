@{
    ViewData["Title"] = "Panel de Control";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Hola Enrique, bienvenido al Panel de COVAR</h2>
        <span class="badge bg-dark">Administrador</span>
    </div>

    <div class="row">
        <div class="col-md-3">
            <div class="card text-white bg-primary mb-3 shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h5 class="card-title">Productos</h5>
                            <h2 class="display-4">@ViewBag.TotalProductos</h2>
                        </div>
                        <i class="bi bi-box-seam fs-1 opacity-50"></i>
                    </div>
                    <a asp-controller="Producto" asp-action="Index" class="text-white text-decoration-none small">Gestionar inventario →</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-success mb-3 shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h5 class="card-title">Marcas</h5>
                            <h2 class="display-4">@ViewBag.TotalMarcas</h2>
                        </div>
                        <i class="bi bi-tags fs-1 opacity-50"></i>
                    </div>
                    <a asp-controller="Marca" asp-action="Index" class="text-white text-decoration-none small">Ver marcas →</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-info mb-3 shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h5 class="card-title">Categorías</h5>
                            <h2 class="display-4">@ViewBag.TotalCategorias</h2>
                        </div>
                        <i class="bi bi-folder fs-1 opacity-50"></i>
                    </div>
                    <a asp-controller="Categoria" asp-action="Index" class="text-white text-decoration-none small">Organizar grupos →</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-danger mb-3 shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h5 class="card-title">Tickets</h5>
                            <h2 class="display-4">@ViewBag.TicketsAbiertos</h2>
                        </div>
                        <i class="bi bi-headset fs-1 opacity-50"></i>
                    </div>
                    <a asp-controller="Ticket" asp-action="Index" class="text-white text-decoration-none small">Atender clientes →</a>
                </div>
            </div>
        </div>
    </div>
</div>