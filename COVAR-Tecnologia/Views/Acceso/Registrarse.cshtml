@model COVAR_Tecnologia.Models.cotec_usuario

@{
    ViewData["Title"] = "Crear Cuenta";
    Layout = "_Layout"; // Usamos el layout normal para que vean el menú
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <h2 class="fw-bold text-primary">Únete a COVAR</h2>
                        <p class="text-muted">Crea tu cuenta para gestionar tus consultas técnicas.</p>
                    </div>

                    @if (ViewData["Mensaje"] != null)
                    {
                        <div class="alert alert-danger">@ViewData["Mensaje"]</div>
                    }

                    <form autocomplete="off" asp-action="Registrarse" method="post">
                        <div class="mb-3">
                            <label class="form-label">Correo Electrónico</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control" type="email" placeholder="nombre@ejemplo.com" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Contraseña</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="bi bi-lock"></i></span>
                                <input name="claveRaw" class="form-control" type="password" placeholder="Mínimo 6 caracteres" required />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Confirmar Contraseña</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="bi bi-shield-check"></i></span>
                                <input name="confirmarClave" class="form-control" type="password" required />
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg shadow-sm">Registrarme Ahora</button>
                        </div>
                    </form>

                    <div class="text-center mt-4">
                        <p class="mb-0">¿Ya tienes cuenta? <a asp-action="Login" class="text-decoration-none fw-bold">Inicia sesión aquí</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
