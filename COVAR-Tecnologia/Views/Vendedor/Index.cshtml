@{
    ViewData["Title"] = "Panel de Vendedor";
}

<div class="container mt-4 mb-5 fade-in-up">
    <div class="d-flex justify-content-between align-items-center mb-5 border-bottom pb-3">
        <div>
            <h2 class="fw-bold mb-0"><i class="bi bi-briefcase-fill text-primary"></i> Hola @User.Identity.Name, bienvenido a tu área</h2>
            <p class="text-muted small mb-0 mt-1">Herramientas de venta y atención al cliente</p>
        </div>
        <span class="badge bg-info text-dark rounded-pill fs-6 px-3 py-2 shadow-sm">
            <i class="bi bi-person-badge-fill text-dark"></i> Vendedor
        </span>
    </div>

    <div class="row g-4 justify-content-center">
        <!-- Productos -->
        <div class="col-md-6 col-lg-5">
            <div class="card text-white product-card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);">
                <div class="card-body p-5 position-relative overflow-hidden">
                    <i class="bi bi-box-seam position-absolute opacity-25" style="font-size: 10rem; right: -20px; top: -10px;"></i>
                    <h4 class="card-title fw-medium opacity-75">Catálogo y Productos</h4>
                    <h1 class="display-3 fw-bold mb-1">@ViewBag.TotalProductos</h1>
                    <p class="mb-4 opacity-75">Gestiona el inventario, marcas y categorías.</p>
                    <a asp-controller="Producto" asp-action="Index" class="btn btn-light fw-bold shadow-sm rounded-pill px-4 stretched-link">
                        Ir a Productos <i class="bi bi-arrow-right-short fs-5 align-middle"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Tickets -->
        <div class="col-md-6 col-lg-5">
            <div class="card text-white product-card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #dc3545 0%, #b02a37 100%);">
                <div class="card-body p-5 position-relative overflow-hidden">
                    <i class="bi bi-headset position-absolute opacity-25" style="font-size: 10rem; right: -20px; top: -10px;"></i>
                    <h4 class="card-title fw-medium opacity-75">Consultas Pendientes</h4>
                    <h1 class="display-3 fw-bold mb-1">@ViewBag.TicketsPendientes</h1>
                    <p class="mb-4 opacity-75">Responde las dudas de los clientes.</p>
                    <a asp-controller="Ticket" asp-action="Index" class="btn btn-light text-danger fw-bold shadow-sm rounded-pill px-4 stretched-link">
                        Atender Tickets <i class="bi bi-arrow-right-short fs-5 align-middle"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
