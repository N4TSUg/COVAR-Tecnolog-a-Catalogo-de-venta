@{
    ViewData["Title"] = "Panel de Vendedor";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Hola, bienvenido a tu área de trabajo</h2>
        <span class="badge bg-info text-dark">Vendedor</span>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card text-white bg-primary mb-3 shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h5 class="card-title">Catálogo y Productos</h5>
                            <h2 class="display-4">@ViewBag.TotalProductos</h2>
                        </div>
                        <i class="bi bi-box-seam fs-1 opacity-50"></i>
                    </div>
                    <p class="small mb-2">Gestiona el inventario, marcas y categorías.</p>
                    <a asp-controller="Producto" asp-action="Index" class="btn btn-light btn-sm text-primary fw-bold">Ir a Productos</a>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card text-white bg-danger mb-3 shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h5 class="card-title">Consultas Pendientes</h5>
                            <h2 class="display-4">@ViewBag.TicketsPendientes</h2>
                        </div>
                        <i class="bi bi-headset fs-1 opacity-50"></i>
                    </div>
                    <p class="small mb-2">Responde las dudas de los clientes.</p>
                    <a asp-controller="Ticket" asp-action="Index" class="btn btn-light btn-sm text-danger fw-bold">Atender Tickets</a>
                </div>
            </div>
        </div>
    </div>
</div>