@model COVAR_Tecnologia.Models.Categoria

@{
    ViewData["Title"] = "Nueva Categoría";
}

<div class="container mt-5 fade-in-up mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden product-card">
                
                <div class="bg-success text-white p-4 d-flex align-items-center">
                    <div class="display-5 me-3"><i class="bi bi-folder-plus"></i></div>
                    <div>
                        <h2 class="fw-bold mb-0">Registrar Nueva Categoría</h2>
                        <p class="small mb-0 text-white">Organiza el inventario</p>
                    </div>
                </div>

                <div class="card-body p-5">
                    <form autocomplete="off" asp-action="Crear" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                        <div class="mb-5">
                            <label asp-for="Nombre" class="form-label text-muted small text-uppercase fw-bold">Nombre de la Categoría</label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent text-muted"><i class="bi bi-folder2-open"></i></span>
                                <input asp-for="Nombre" class="form-control border-start-0 ps-0" placeholder="Ej: Laptops, Periféricos, etc." />
                            </div>
                            <span asp-validation-for="Nombre" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-bold">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-success rounded-pill px-5 fw-bold shadow-sm btn-hover-grow">
                                Guardar <i class="bi bi-check2"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

