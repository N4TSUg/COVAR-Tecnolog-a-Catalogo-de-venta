@model IEnumerable<COVAR_Tecnologia.Models.cotec_ticketSoporte>
@{
    ViewData["Title"] = "Mis Consultas";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">🛠️ Mis Consultas de Soporte</h2>
        <a asp-action="Crear" class="btn btn-primary">+ Nuevo Ticket</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Fecha</th>
                        <th>Asunto</th>
                        <th>Estado</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="5" class="text-center py-4">No tienes consultas activas.</td></tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>#@item.Id</td>
                            <td>@item.FechaCreacion.ToString("dd/MM/yyyy")</td>
                            <td class="fw-bold">@item.Asunto</td>
                            <td>
                                @if (item.Estado == COVAR_Tecnologia.Models.cotec_estadoTicket.Abierto)
                                {
                                    <span class="badge bg-warning text-dark">En Proceso</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Resuelto</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Chat" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Ver Chat</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>