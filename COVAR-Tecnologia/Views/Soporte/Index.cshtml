@model IEnumerable<COVAR_Tecnologia.Models.cotec_ticketSoporte>
@{
    ViewData["Title"] = "Mis Consultas";
}

<div class="container mt-4 mb-5 fade-in-up">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <div>
            <h2 class="fw-bold mb-0 text-primary"><i class="bi bi-headset"></i> Mis Consultas de Soporte</h2>
            <p class="text-muted small mt-1 mb-0">Historial de tus tickets de atención al cliente.</p>
        </div>
        <a asp-action="Crear" class="btn btn-primary rounded-pill fw-bold shadow-sm btn-hover-grow px-4">
            <i class="bi bi-plus-lg"></i> Nuevo Ticket
        </a>
    </div>

    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">Ticket</th>
                            <th>Asunto</th>
                            <th>Fecha</th>
                            <th>Estado</th>
                            <th class="text-center pe-4">Acción</th>
                        </tr>
                    </thead>
                    <tbody class="bg-body">
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <div class="text-muted opacity-50 mb-3"><i class="bi bi-inbox fs-1"></i></div>
                                    <h5 class="fw-bold">No tienes consultas activas.</h5>
                                    <p class="text-muted">Si necesitas ayuda, puedes abrir un nuevo ticket en cualquier momento.</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4"><span class="badge bg-secondary rounded-pill px-3 py-2">#@item.Id</span></td>
                                    <td class="fw-bold text-wrap" style="max-width: 300px;">@item.Asunto</td>
                                    <td><span class="text-muted"><i class="bi bi-calendar-event"></i> @item.FechaCreacion.ToString("dd/MM/yyyy")</span></td>
                                    <td>
                                        @if (item.Estado == COVAR_Tecnologia.Models.cotec_estadoTicket.Abierto)
                                        {
                                            <span class="badge bg-warning text-dark rounded-pill shadow-sm px-3 py-2"><i class="bi bi-clock-history"></i> En Proceso</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success rounded-pill shadow-sm px-3 py-2"><i class="bi bi-check-circle-fill"></i> Resuelto</span>
                                        }
                                    </td>
                                    <td class="text-center pe-4">
                                        <a asp-action="Chat" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-bold btn-hover-grow shadow-sm">
                                            <i class="bi bi-chat-dots-fill"></i> Ver Chat
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>