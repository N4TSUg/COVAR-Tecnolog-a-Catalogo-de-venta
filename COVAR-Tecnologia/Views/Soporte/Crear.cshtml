@{
    ViewData["Title"] = "Nueva Consulta";
}

<div class="container mt-4 mb-5 fade-in-up">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-header p-4 border-0" style="background: linear-gradient(135deg, var(--bs-primary) 0%, #004085 100%) !important;">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-white bg-opacity-25 p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                            <i class="bi bi-envelope-paper-heart-fill text-white fs-3"></i>
                        </div>
                        <div class="text-white">
                            <h4 class="mb-1 fw-bold">Abrir Ticket de Soporte</h4>
                            <p class="mb-0 text-white small">Estamos aquí para ayudarte. Cuéntanos tu problema.</p>
                        </div>
                    </div>
                </div>

                <div class="card-body p-5 bg-body">
                    @if (ViewData["Mensaje"] != null)
                    {
                        <div class="alert alert-danger shadow-sm rounded-3 mb-4 border-0 border-start border-4 border-danger">
                            <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i> @ViewData["Mensaje"]
                        </div>
                    }

                    <form autocomplete="off" asp-action="Crear" method="post" class="needs-validation">
                        
                        <div class="mb-4">
                            <label for="productoId" class="form-label fw-bold text-muted small text-uppercase">Producto relacionado (Opcional)</label>
                            <div class="input-group input-group-lg shadow-sm rounded-3 overflow-hidden">
                                <span class="input-group-text bg-body-tertiary border-0 text-primary px-4"><i class="bi bi-box-seam"></i></span>
                                <select id="productoId" name="productoId" class="form-select bg-body-tertiary border-0" asp-items="ViewBag.Productos">
                                    <option value="">-- Consulta General (Sin producto) --</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="asunto" class="form-label fw-bold text-muted small text-uppercase">Asunto de la consulta <span class="text-danger">*</span></label>
                            <div class="input-group input-group-lg shadow-sm rounded-3 overflow-hidden">
                                <span class="input-group-text bg-body-tertiary border-0 text-primary px-4"><i class="bi bi-chat-left-text-fill"></i></span>
                                <input id="asunto" type="text" name="asunto" class="form-control bg-body-tertiary border-0" placeholder="Ej: Problema con garantía del Mouse" required />
                            </div>
                        </div>

                        <div class="mb-5">
                            <label for="mensajeInicial" class="form-label fw-bold text-muted small text-uppercase">Detalla tu problema <span class="text-danger">*</span></label>
                            <div class="input-group shadow-sm rounded-3 overflow-hidden">
                                <span class="input-group-text bg-body-tertiary border-0 text-primary px-4 align-items-start pt-3"><i class="bi bi-pencil-square"></i></span>
                                <textarea id="mensajeInicial" name="mensajeInicial" class="form-control bg-body-tertiary border-0 py-3" rows="5" placeholder="Escribe aquí todos los detalles posibles para poder ayudarte mejor..." required></textarea>
                            </div>
                        </div>

                        <div class="d-grid gap-3 d-md-flex justify-content-md-end border-top pt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-5 fw-bold btn-hover-grow">
                                Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm btn-hover-grow">
                                Enviar Ticket <i class="bi bi-send ms-2"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            
            <div class="text-center mt-4">
                <p class="text-muted small"><i class="bi bi-clock-history"></i> Tiempo estimado de respuesta: <strong>24 a 48 horas</strong> hábiles.</p>
            </div>
        </div>
    </div>
</div>
