@model COVAR_Tecnologia.Models.CatalogoViewModel

@{
    ViewData["Title"] = "Inicio - Catálogo";
}

<div class="bg-primary text-white text-center py-5 mb-5 rounded shadow">
    <h1 class="display-4 fw-bold">Bienvenido a COVAR Tecnología</h1>
    <p class="lead">Los mejores componentes y periféricos al mejor precio.</p>
</div>

<div class="container">
    
    <!-- Sección de Filtros -->
    <div class="card shadow-sm mb-4 border-0 bg-light">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Buscar Producto</label>
                    <input type="text" name="busqueda" class="form-control" placeholder="Ejem: Laptop, Mouse..." value="@Model.Busqueda" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Categoría</label>
                    <select name="categoriaId" class="form-select" asp-items="@Model.Categorias">
                        <option value="">Todas las Categorías</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Marca</label>
                    <select name="marcaId" class="form-select" asp-items="@Model.Marcas">
                        <option value="">Todas las Marcas</option>
                    </select>
                </div>
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-primary fw-bold">
                        <i class="bi bi-search"></i> Filtrar
                    </button>
                    @if(!string.IsNullOrEmpty(Model.Busqueda) || Model.CategoriaId.HasValue || Model.MarcaId.HasValue)
                    {
                        <a asp-action="Index" class="btn btn-link text-danger mt-1 text-decoration-none">Limpiar filtros</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col">
            <h2 class="border-bottom pb-2">Catálogo de Productos</h2>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4 mb-5">

        @if (!Model.Productos.Any())
        {
            <div class="col-12 text-center py-5">
                <h4 class="text-muted">No se encontraron productos.</h4>
                <p>Intenta con otros filtros o términos de búsqueda.</p>
            </div>
        }
        else
        {
            @foreach (var item in Model.Productos)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">

                        @if (!string.IsNullOrEmpty(item.ImagenURL))
                        {
                            <img src="@item.ImagenURL" class="card-img-top" alt="@item.Nombre" style="height: 200px; object-fit: contain; padding: 10px;">
                        }
                        else
                        {
                            <img src="https://via.placeholder.com/200x200?text=Sin+Imagen" class="card-img-top" alt="Sin imagen" style="height: 200px; object-fit: contain;">
                        }

                        <div class="card-body d-flex flex-column">
                            <div class="mb-2">
                                <span class="badge bg-secondary">@item.Categoria.Nombre</span>
                                <span class="badge bg-info text-dark">@item.Marca.Nombre</span>
                            </div>

                            <h5 class="card-title fw-bold">@item.Nombre</h5>
                            <p class="card-text text-muted small flex-grow-1">
                                @if (item.Descripcion != null && item.Descripcion.Length > 60)
                                {
                                    @(item.Descripcion.Substring(0, 60) + "...")
                                }
                                else
                                {
                                    @item.Descripcion
                                }
                            </p>

                            <h4 class="text-success fw-bold mb-3 text-center">@item.Precio.ToString("C")</h4>

                            <div class="d-grid gap-2">
                                <a asp-action="Detalle" asp-route-id="@item.Id" class="btn btn-outline-primary fw-bold">
                                    <i class="bi bi-eye"></i> Ver Detalles
                                </a>
                                <a href="@item.GetWhatsAppLink()" target="_blank" class="btn btn-success fw-bold">
                                    <i class="bi bi-whatsapp"></i> Comprar
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- Paginación -->
    @if (Model.TotalPaginas > 1)
    {
        <nav aria-label="Navegación de páginas de catálogo">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" 
                       asp-route-busqueda="@Model.Busqueda" 
                       asp-route-categoriaId="@Model.CategoriaId" 
                       asp-route-marcaId="@Model.MarcaId" 
                       asp-route-pagina="@(Model.PaginaActual - 1)">Anterior</a>
                </li>
                
                @for (int i = 1; i <= Model.TotalPaginas; i++)
                {
                    <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-busqueda="@Model.Busqueda" 
                           asp-route-categoriaId="@Model.CategoriaId" 
                           asp-route-marcaId="@Model.MarcaId" 
                           asp-route-pagina="@i">@i</a>
                    </li>
                }

                <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" 
                       asp-route-busqueda="@Model.Busqueda" 
                       asp-route-categoriaId="@Model.CategoriaId" 
                       asp-route-marcaId="@Model.MarcaId" 
                       asp-route-pagina="@(Model.PaginaActual + 1)">Siguiente</a>
                </li>
            </ul>
        </nav>
    }
</div>
