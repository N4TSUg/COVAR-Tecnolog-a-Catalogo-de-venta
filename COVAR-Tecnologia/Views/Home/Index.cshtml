@model COVAR_Tecnologia.Models.CatalogoViewModel

@{
    ViewData["Title"] = "Inicio - Catálogo";
}

<div class="bg-primary text-white text-center py-5 mb-5 rounded shadow fade-in-up" style="background: linear-gradient(135deg, var(--bs-primary) 0%, #004085 100%) !important;">
    <h1 class="display-4 fw-bold mb-3"><i class="bi bi-rocket-takeoff"></i> Bienvenido a COVAR Tecnología</h1>
    <p class="lead fs-4">Componentes premium, periféricos avanzados y el mejor servicio garantizado.</p>
</div>

<div class="container fade-in-up">
    
    <!-- Sección de Filtros Modernizada -->
    <div class="card shadow-sm mb-5 filter-panel">
        <div class="card-body p-4">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-bold text-muted small text-uppercase">Buscar Producto</label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="busqueda" class="form-control border-start-0 ps-0" placeholder="Ej: Laptop, Mouse..." value="@Model.Busqueda" />
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold text-muted small text-uppercase">Categoría</label>
                    <select name="categoriaId" class="form-select" asp-items="@Model.Categorias">
                        <option value="">Todas las Categorías</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold text-muted small text-uppercase">Marca</label>
                    <select name="marcaId" class="form-select" asp-items="@Model.Marcas">
                        <option value="">Todas las Marcas</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary fw-bold flex-grow-1 btn-hover-grow">
                        Filtrar
                    </button>
                    @if(!string.IsNullOrEmpty(Model.Busqueda) || Model.CategoriaId.HasValue || Model.MarcaId.HasValue)
                    {
                        <a asp-action="Index" class="btn btn-outline-danger" title="Limpiar filtros">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <div class="row mb-4 align-items-center">
        <div class="col">
            <h2 class="fw-bold mb-0">Catálogo de Productos <i class="bi bi-stars text-warning"></i></h2>
            <p class="text-muted small">Explora nuestra colección de alta tecnología.</p>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4 mb-5 fade-in-up">
        @if (!Model.Productos.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="display-1 text-muted mb-3"><i class="bi bi-box-seam"></i></div>
                <h4 class="text-muted fw-bold">No se encontraron productos.</h4>
                <p>Intenta con otros filtros o términos de búsqueda.</p>
            </div>
        }
        else
        {
            @foreach (var item in Model.Productos)
            {
                <div class="col">
                    <div class="card product-card">
                        <div class="product-img-wrapper position-relative">
                            @if (!string.IsNullOrEmpty(item.ImagenURL))
                            {
                                <img src="@item.ImagenURL" class="product-img" alt="@item.Nombre">
                            }
                            else
                            {
                                <img src="https://via.placeholder.com/300x300?text=Sin+Imagen" class="product-img" alt="Sin imagen">
                            }
                            <span class="position-absolute top-0 end-0 badge bg-primary m-2 shadow-sm rounded-pill px-3">Nuevo</span>
                        </div>

                        <div class="card-body d-flex flex-column p-4">
                            <div class="mb-2 d-flex gap-1 flex-wrap">
                                <span class="badge bg-dark rounded-pill fw-normal">@item.Categoria.Nombre</span>
                                <span class="badge bg-secondary rounded-pill fw-normal"><i class="bi bi-tag-fill"></i> @item.Marca.Nombre</span>
                            </div>

                            <h5 class="product-title" title="@item.Nombre">@item.Nombre</h5>
                            
                            <p class="card-text text-muted small flex-grow-1">
                                @if (item.Descripcion != null && item.Descripcion.Length > 60)
                                {
                                    @(item.Descripcion.Substring(0, 60) + "...")
                                }
                                else
                                {
                                    @item.Descripcion
                                }
                            </p>

                            <div class="mt-auto pt-3 border-top">
                                <h4 class="product-price mb-3">@item.Precio.ToString("C")</h4>

                                <div class="d-grid gap-2">
                                    <a href="@item.GetWhatsAppLink()" target="_blank" class="btn btn-success fw-bold btn-hover-grow">
                                        <i class="bi bi-whatsapp"></i> Lo quiero
                                    </a>
                                    <a asp-action="Detalle" asp-route-id="@item.Id" class="btn btn-light fw-bold border">
                                        Ver Detalles
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- Paginación -->
    @if (Model.TotalPaginas > 1)
    {
        <nav aria-label="Navegación de catálogo">
            <ul class="pagination justify-content-center shadow-sm rounded-pill overflow-hidden">
                <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                    <a class="page-link border-0 px-4" asp-action="Index" 
                       asp-route-busqueda="@Model.Busqueda" 
                       asp-route-categoriaId="@Model.CategoriaId" 
                       asp-route-marcaId="@Model.MarcaId" 
                       asp-route-pagina="@(Model.PaginaActual - 1)"><i class="bi bi-chevron-left"></i></a>
                </li>
                
                @for (int i = 1; i <= Model.TotalPaginas; i++)
                {
                    <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                        <a class="page-link border-0 fw-bold px-3" asp-action="Index" 
                           asp-route-busqueda="@Model.Busqueda" 
                           asp-route-categoriaId="@Model.CategoriaId" 
                           asp-route-marcaId="@Model.MarcaId" 
                           asp-route-pagina="@i">@i</a>
                    </li>
                }

                <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                    <a class="page-link border-0 px-4" asp-action="Index" 
                       asp-route-busqueda="@Model.Busqueda" 
                       asp-route-categoriaId="@Model.CategoriaId" 
                       asp-route-marcaId="@Model.MarcaId" 
                       asp-route-pagina="@(Model.PaginaActual + 1)"><i class="bi bi-chevron-right"></i></a>
                </li>
            </ul>
        </nav>
    }
</div>

