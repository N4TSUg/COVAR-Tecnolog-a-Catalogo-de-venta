@model COVAR_Tecnologia.Models.cotec_producto

@{
    ViewData["Title"] = Model.Nombre;
}

<div class="container mt-4 mb-5 fade-in-up">
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary btn-hover-grow rounded-pill px-4 shadow-sm">
            <i class="bi bi-arrow-left"></i> Volver al Catálogo
        </a>
    </div>

    <div class="card product-card shadow-lg border-0 overflow-hidden">
        <div class="row g-0">
            <!-- Columna de la Imagen -->
            <div class="col-md-6 d-flex align-items-center justify-content-center p-4 border-end" style="background-color: var(--bs-tertiary-bg);">
                <div class="product-img-wrapper w-100 h-100 bg-transparent">
                    @if (!string.IsNullOrEmpty(Model.ImagenURL))
                    {
                        <img src="@Model.ImagenURL" class="product-img" alt="@Model.Nombre" style="max-height: 500px; width: 100%; object-fit: contain;">
                    }
                    else
                    {
                        <img src="https://via.placeholder.com/500x500?text=Sin+Imagen" class="product-img" alt="Sin imagen">
                    }
                </div>
            </div>

            <!-- Columna de la Información -->
            <div class="col-md-6">
                <div class="card-body p-5 d-flex flex-column h-100">

                    <div class="mb-3 d-flex gap-2">
                        <span class="badge bg-dark rounded-pill fs-6 fw-normal">@Model.Categoria.Nombre</span>
                        <span class="badge bg-secondary rounded-pill fs-6 fw-normal"><i class="bi bi-tag-fill"></i> @Model.Marca.Nombre</span>
                    </div>

                    <h2 class="card-title fw-bold mb-3">@Model.Nombre</h2>

                    <h1 class="product-price display-5 fw-bold mb-4">@Model.Precio.ToString("C")</h1>

                    <div class="mb-4 flex-grow-1">
                        <h5 class="fw-bold border-bottom pb-2"><i class="bi bi-info-circle"></i> Descripción del Producto</h5>
                        <p class="text-muted mt-3 fs-5" style="white-space: pre-wrap; line-height: 1.6;">@Model.Descripcion</p>
                    </div>

                    <div class="d-grid gap-3 mt-auto pt-4 border-top">
                        <a href="@Model.GetWhatsAppLink()" target="_blank" class="btn btn-success btn-lg fw-bold shadow-sm btn-hover-grow py-3">
                            <i class="bi bi-whatsapp fs-4 me-2 align-middle"></i> Lo quiero, pedir por WhatsApp
                        </a>

                        <div class="text-center mt-2 text-muted small">
                            <i class="bi bi-shield-check text-primary"></i> Compra segura y atención personalizada
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
