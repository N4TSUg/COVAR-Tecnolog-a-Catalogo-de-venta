@model COVAR_Tecnologia.Models.cotec_producto

@{
    ViewData["Title"] = Model.Nombre;
}

<div class="container mt-5 mb-5">
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Volver al Catálogo
        </a>
    </div>

    <div class="card shadow border-0 rounded-4 overflow-hidden">
        <div class="row g-0">
            <div class="col-md-6 bg-white d-flex align-items-center justify-content-center p-4 border-end">
                @if (!string.IsNullOrEmpty(Model.ImagenURL))
                {
                    <img src="@Model.ImagenURL" class="img-fluid rounded" alt="@Model.Nombre" style="max-height: 500px; object-fit: contain;">
                }
                else
                {
                    <img src="https://via.placeholder.com/500x500?text=Sin+Imagen" class="img-fluid rounded" alt="Sin imagen">
                }
            </div>

            <div class="col-md-6 bg-light">
                <div class="card-body p-5 d-flex flex-column h-100">

                    <div class="mb-3">
                        <span class="badge bg-secondary fs-6 me-2">@Model.Categoria.Nombre</span>
                        <span class="badge bg-info text-dark fs-6">@Model.Marca.Nombre</span>
                    </div>

                    <h2 class="card-title fw-bold mb-3 text-dark">@Model.Nombre</h2>

                    <h1 class="text-success fw-bold mb-4">@Model.Precio.ToString("C")</h1>

                    <div class="mb-4 flex-grow-1">
                        <h5 class="fw-bold border-bottom pb-2">Descripción del Producto</h5>
                        <p class="text-muted mt-3" style="white-space: pre-wrap; line-height: 1.6;">@Model.Descripcion</p>
                    </div>

                    <div class="d-grid gap-3 mt-auto">
                        <a href="@Model.GetWhatsAppLink()" target="_blank" class="btn btn-success btn-lg fw-bold shadow-sm">
                            <i class="bi bi-whatsapp fs-5 me-2"></i> Lo quiero, pedir por WhatsApp
                        </a>

                        <div class="text-center mt-2 text-muted small">
                            <i class="bi bi-shield-check text-primary"></i> Compra segura y atención personalizada
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>