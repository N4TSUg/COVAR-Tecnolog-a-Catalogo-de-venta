@model COVAR_Tecnologia.Models.cotec_producto

@{
    ViewData["Title"] = Model.Nombre;
}

<div class="container mt-4 mb-5 fade-in-up">
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary btn-hover-grow rounded-pill px-4 shadow-sm fw-bold">
            <i class="bi bi-arrow-left"></i> Volver al Catálogo
        </a>
    </div>

    <div class="card product-card shadow-lg border-0 rounded-4 overflow-hidden">
        <div class="row g-0">
            <!-- Columna de la Imagen -->
            <div class="col-md-6 d-flex align-items-center justify-content-center p-5 position-relative" style="background-color: var(--bs-tertiary-bg);">
                <div class="position-absolute top-0 start-0 m-4">
                    <span class="badge bg-danger rounded-pill px-3 py-2 shadow-sm fs-6"><i class="bi bi-fire"></i> Destacado</span>
                </div>
                
                <div class="product-img-wrapper w-100 h-100 bg-transparent text-center">
                    @if (!string.IsNullOrEmpty(Model.ImagenURL))
                    {
                        <img src="@Model.ImagenURL" class="product-img img-fluid" alt="@Model.Nombre" style="max-height: 450px; object-fit: contain; transition: transform 0.3s ease;">
                    }
                    else
                    {
                        <img src="https://via.placeholder.com/500x500?text=Sin+Imagen" class="product-img img-fluid opacity-50" alt="Sin imagen">
                    }
                </div>
            </div>

            <!-- Columna de la Información -->
            <div class="col-md-6 bg-body">
                <div class="card-body p-5 d-flex flex-column h-100">

                    <div class="mb-3 d-flex gap-2 flex-wrap">
                        <span class="badge bg-primary rounded-pill fs-6 fw-normal shadow-sm px-3">@Model.Categoria.Nombre</span>
                        <span class="badge bg-secondary rounded-pill fs-6 fw-normal shadow-sm px-3"><i class="bi bi-tags-fill"></i> @Model.Marca.Nombre</span>
                    </div>

                    <h2 class="card-title fw-bolder mb-3 display-6">@Model.Nombre</h2>

                    <div class="d-flex align-items-end gap-2 mb-4">
                        <h1 class="product-price display-4 fw-bolder text-success mb-0">@Model.Precio.ToString("C")</h1>
                        <span class="text-muted mb-2">Precio Online</span>
                    </div>

                    <div class="mb-5 flex-grow-1">
                        <h5 class="fw-bold border-bottom pb-2 text-primary"><i class="bi bi-info-circle-fill"></i> Descripción del Producto</h5>
                        <p class="text-muted mt-3 fs-5 fw-light" style="white-space: pre-wrap; line-height: 1.8;">@Model.Descripcion</p>
                    </div>

                    <div class="mt-auto pt-4 border-top">
                        <div class="row g-3">
                            <div class="col-12">
                                <a href="@Model.GetWhatsAppLink()" target="_blank" class="btn btn-success w-100 btn-lg fw-bold shadow btn-hover-grow py-3 rounded-pill d-flex justify-content-center align-items-center gap-2">
                                    <i class="bi bi-whatsapp fs-4"></i> Lo quiero, pedir por WhatsApp
                                </a>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4 text-muted small px-2">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-shield-check text-primary fs-5"></i> 
                                <span>Garantía de Tienda</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-shop text-primary fs-5"></i> 
                                <span>Recojo en tienda</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-credit-card text-primary fs-5"></i> 
                                <span>Pago Seguro</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
