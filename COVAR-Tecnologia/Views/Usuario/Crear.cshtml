@model COVAR_Tecnologia.Models.cotec_usuario

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow border-primary">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Dar Acceso a Personal</h4>
                </div>
                <div class="card-body">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <form autocomplete="off" asp-action="Crear">
                        <div class="mb-3">
                            <label class="form-label">Correo Electrónico</label>
                            <input asp-for="Email" class="form-control" type="email" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Contraseña Temporal</label>
                            <input name="claveRaw" class="form-control" type="password" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Rol del Usuario</label>
                            <select asp-for="RolId" class="form-select" asp-items="ViewBag.Roles"></select>
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">Crear Cuenta</button>
                            <a asp-action="Index" class="btn btn-link">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
