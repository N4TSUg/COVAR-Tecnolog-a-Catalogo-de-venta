@model COVAR_Tecnologia.Models.cotec_usuario

@{
    ViewData["Title"] = "Editar Acceso de Personal";
}

<div class="container mt-5 fade-in-up mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden product-card">
                
                <div class="bg-primary text-white p-4 d-flex align-items-center">
                    <div class="display-5 me-3"><i class="bi bi-person-plus-fill"></i></div>
                    <div>
                        <h2 class="fw-bold mb-0">Editar Acceso de Personal</h2>
                        <p class="small mb-0 opacity-75">Actualiza el rol o email del usuario</p>
                    </div>
                </div>

                <div class="card-body p-5">
                    <form autocomplete="off" asp-action="Editar" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                        <div class="mb-4">
                            <label class="form-label text-muted small text-uppercase fw-bold">Correo Electrónico</label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent text-muted"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control border-start-0 ps-0" type="email" placeholder="nombre@covar.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-muted small text-uppercase fw-bold">Nueva Contraseña (Opcional)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent text-muted"><i class="bi bi-key"></i></span>
                                <input name="claveRaw" id="passTemporal" class="form-control border-start-0 border-end-0 ps-0" type="password" placeholder="Mínimo 6 caracteres" />
                                <button class="btn btn-outline-secondary border-start-0 bg-transparent text-muted" type="button" onclick="togglePassword(this)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>

                        <div class="mb-5">
                            <label asp-for="RolId" class="form-label text-muted small text-uppercase fw-bold">Rol del Usuario</label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent text-muted"><i class="bi bi-person-badge"></i></span>
                                <select asp-for="RolId" class="form-select border-start-0 ps-0" asp-items="ViewBag.Roles"></select>
                            </div>
                            <span asp-validation-for="RolId" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-bold">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm btn-hover-grow">
                                Actualizar Cuenta <i class="bi bi-check2"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

