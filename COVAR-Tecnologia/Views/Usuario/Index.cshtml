@model IEnumerable<COVAR_Tecnologia.Models.cotec_usuario>

<div class="container mt-4">
    <div class="d-flex justify-content-between mb-3">
        <h2>👥 Gestión de Personal</h2>
        <a asp-action="Crear" class="btn btn-primary">+ Nuevo Acceso</a>
    </div>

    <div class="card shadow">
        <div class="card-body">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Email / Usuario</th>
                        <th>Rol Asignado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Email</td>
                            <td>
                                <span class="badge @(item.Rol.Nombre == "Administrador" ? "bg-dark" : "bg-info")">
                                    @item.Rol.Nombre
                                </span>
                            </td>
                            <td class="text-center">
                                @if (item.Rol.Nombre != "Administrador")
                                {
                                    <a asp-action="Eliminar" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm" onclick="return confirm('¿Revocar acceso?')">Eliminar</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>