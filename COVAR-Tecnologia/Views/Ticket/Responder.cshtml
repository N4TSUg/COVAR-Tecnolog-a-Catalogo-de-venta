@model COVAR_Tecnologia.Models.cotec_ticketSoporte

@{
    ViewData["Title"] = "Responder Ticket";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-info">
                <div class="card-header bg-info text-white fw-bold">
                    Detalles del Caso #@Model.Id
                </div>
                <div class="card-body">
                    <p><strong>Cliente:</strong> @(Model.Usuario?.Email ?? "Anónimo")</p>
                    <p><strong>Fecha:</strong> @Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</p>
                    <p><strong>Asunto:</strong> @Model.Asunto</p>
                    <p><strong>Nivel:</strong> @(Model.EsComplejo ? "🔴 Complejo" : "🟢 Estándar")</p>
                    <p>
                        <strong>Estado:</strong>
                        <span class="badge @(Model.Estado == COVAR_Tecnologia.Models.cotec_estadoTicket.Abierto ? "bg-warning text-dark" : "bg-success")">
                            @Model.Estado
                        </span>
                    </p>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mt-2">🔙 Volver a la bandeja</a>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white fw-bold">
                    💬 Historial de Conversación
                </div>

                <div class="card-body" id="chatContainer" style="height: 400px; overflow-y: auto; background-color: #f8f9fa;">
                    @if (Model.Mensajes == null || !Model.Mensajes.Any())
                    {
                        <p class="text-center text-muted mt-5" id="noMessagesText">No hay mensajes registrados. Esperando consulta del cliente.</p>
                    }
                    else
                    {
                        foreach (var msj in Model.Mensajes.OrderBy(m => m.FechaEnvio))
                        {
                            <div class="d-flex mb-3 @(msj.EsRespuestaAdmin ? "justify-content-end" : "justify-content-start")">
                                <div class="p-3 rounded shadow-sm @(msj.EsRespuestaAdmin ? "bg-primary text-white" : "bg-white border")" style="max-width: 75%;">
                                    <p class="mb-1">@msj.Texto</p>
                                    <small class="@(msj.EsRespuestaAdmin ? "text-light" : "text-muted")" style="font-size: 0.75rem;">
                                        @msj.FechaEnvio.ToString("dd/MM HH:mm")
                                        @(msj.EsRespuestaAdmin ? "(Tú)" : "(Cliente)")
                                    </small>
                                </div>
                            </div>
                        }
                    }
                </div>

                @if (Model.Estado == COVAR_Tecnologia.Models.cotec_estadoTicket.Abierto)
                {
                    <div class="card-footer bg-white">
                        <form id="chatForm" autocomplete="off" asp-action="Responder" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />

                            <div class="mb-3">
                                <textarea id="textoMensaje" name="textoMensaje" class="form-control" rows="3" placeholder="Escribe la respuesta al cliente aquí..."></textarea>
                            </div>

                            <div class="d-flex justify-content-between align-items-center">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="cerrarTicket" value="true" id="checkCerrar">
                                    <label class="form-check-label text-danger fw-bold" for="checkCerrar">
                                        Marcar como resuelto / Cerrar Ticket
                                    </label>
                                </div>
                                <button type="submit" class="btn btn-primary">
                                    Enviar Respuesta <i class="bi bi-send"></i>
                                </button>
                            </div>
                        </form>
                    </div>
                }
                else
                {
                    <div class="card-footer text-center bg-light text-muted fw-bold">
                        🔒 Este ticket ha sido cerrado. Ya no admite respuestas.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        var ticketId = "@Model.Id";
        var isAdmin = true;

        var connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .build();

        connection.on("ReceiveMessage", function (mensaje, fechaFormateada, sentByAdmin) {
            var chatContainer = document.getElementById("chatContainer");
            var noMsgs = document.getElementById("noMessagesText");
            if (noMsgs) noMsgs.style.display = "none";

            var isMine = sentByAdmin === isAdmin;
            var alignmentClass = isMine ? "justify-content-end" : "justify-content-start";
            var bgClass = isMine ? "bg-primary text-white" : "bg-white border";
            var textClass = isMine ? "text-light" : "text-muted";
            var senderName = sentByAdmin ? "(Tú)" : "(Cliente)";

            var msgDiv = document.createElement("div");
            msgDiv.className = "d-flex mb-3 " + alignmentClass;
            msgDiv.innerHTML = `
                <div class="p-3 rounded shadow-sm ` + bgClass + `" style="max-width: 75%;">
                    <p class="mb-1">` + mensaje + `</p>
                    <small class="` + textClass + `" style="font-size: 0.75rem;">
                        ` + fechaFormateada + ` ` + senderName + `
                    </small>
                </div>
            `;
            chatContainer.appendChild(msgDiv);
            chatContainer.scrollTop = chatContainer.scrollHeight;
        });

        connection.start().then(function () {
            connection.invoke("JoinTicketGroup", ticketId);
        }).catch(function (err) {
            return console.error(err.toString());
        });

        document.getElementById("chatForm")?.addEventListener("submit", function (e) {
            var checkCerrar = document.getElementById("checkCerrar");
            if (checkCerrar && checkCerrar.checked) {
                // If closing, do standard form post
                return;
            }

            e.preventDefault();
            var mensajeInput = document.getElementById("textoMensaje");
            var mensaje = mensajeInput.value.trim();

            if (mensaje) {
                connection.invoke("SendMessage", parseInt(ticketId), mensaje, isAdmin).catch(function (err) {
                    return console.error(err.toString());
                });
                mensajeInput.value = "";
            }
        });

        // Scroll to bottom on load
        var cc = document.getElementById("chatContainer");
        if(cc) cc.scrollTop = cc.scrollHeight;
    </script>
}
