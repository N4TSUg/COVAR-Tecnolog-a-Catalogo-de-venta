@model COVAR_Tecnologia.Models.cotec_ticketSoporte

@{
    ViewData["Title"] = "Responder Ticket";
}

<div class="container mt-4 mb-5 fade-in-up">
    <div class="row g-4">
        <!-- Detalles del Caso -->
        <div class="col-md-4">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-dark text-white fw-bold p-3 border-0 rounded-top-4">
                    <i class="bi bi-info-circle-fill text-info me-2"></i> Detalles del Caso #@Model.Id
                </div>
                <div class="card-body p-4 bg-body">
                    <div class="mb-3">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1">Cliente</small>
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-person-circle fs-4 text-secondary"></i>
                            <span class="fw-bold">@(Model.Usuario?.Email ?? "Anónimo")</span>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1">Fecha de Creación</small>
                        <span><i class="bi bi-calendar-event text-secondary"></i> @Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1">Asunto</small>
                        <p class="mb-0 fw-medium">@Model.Asunto</p>
                    </div>

                    <div class="mb-3 d-flex justify-content-between align-items-center">
                        <small class="text-muted text-uppercase fw-bold">Nivel</small>
                        @if (Model.EsComplejo)
                        {
                            <span class="badge bg-danger rounded-pill px-3 py-2"><i class="bi bi-exclamation-triangle-fill"></i> Complejo</span>
                        }
                        else
                        {
                            <span class="badge bg-info text-dark rounded-pill px-3 py-2"><i class="bi bi-info-circle-fill"></i> Estándar</span>
                        }
                    </div>

                    <div class="mb-4 d-flex justify-content-between align-items-center">
                        <small class="text-muted text-uppercase fw-bold">Estado</small>
                        <span class="badge rounded-pill px-3 py-2 @(Model.Estado == COVAR_Tecnologia.Models.cotec_estadoTicket.Abierto ? "bg-warning text-dark" : "bg-success")">
                            @if(Model.Estado == COVAR_Tecnologia.Models.cotec_estadoTicket.Abierto) { <i class="bi bi-door-open-fill"></i> } else { <i class="bi bi-door-closed-fill"></i> } @Model.Estado
                        </span>
                    </div>
                    
                    <a asp-action="Index" class="btn btn-outline-secondary w-100 rounded-pill fw-bold">
                        <i class="bi bi-arrow-left"></i> Volver a la bandeja
                    </a>
                </div>
            </div>
        </div>

        <!-- Chat -->
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden h-100 d-flex flex-column">
                <div class="card-header bg-primary text-white p-3 border-0" style="background: linear-gradient(135deg, var(--bs-primary) 0%, #004085 100%) !important;">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-chat-dots-fill fs-4"></i>
                        <h5 class="mb-0 fw-bold">Historial de Conversación</h5>
                    </div>
                </div>

                <div class="card-body p-4 flex-grow-1" id="chatContainer" style="min-height: 400px; max-height: 500px; overflow-y: auto; background-color: var(--bs-tertiary-bg);">
                    @if (Model.Mensajes == null || !Model.Mensajes.Any())
                    {
                        <div class="h-100 d-flex flex-column align-items-center justify-content-center opacity-50" id="noMessagesText">
                            <i class="bi bi-chat-square-text" style="font-size: 3rem;"></i>
                            <p class="mt-3 fw-bold">No hay mensajes registrados.</p>
                            <small>Esperando consulta del cliente.</small>
                        </div>
                    }
                    else
                    {
                        foreach (var msj in Model.Mensajes.OrderBy(m => m.FechaEnvio))
                        {
                            <div class="d-flex mb-3 @(msj.EsRespuestaAdmin ? "justify-content-end" : "justify-content-start")">
                                <div class="p-3 shadow-sm @(msj.EsRespuestaAdmin ? "bg-primary text-white text-end" : "bg-body border")" style="max-width: 80%; border-radius: 1.5rem; @(msj.EsRespuestaAdmin ? "border-bottom-right-radius: 0.25rem;" : "border-bottom-left-radius: 0.25rem;")">
                                    <p class="mb-1" style="word-wrap: break-word;">@msj.Texto</p>
                                    <small class="@(msj.EsRespuestaAdmin ? "text-white-50" : "text-muted")" style="font-size: 0.75rem;">
                                        @msj.FechaEnvio.ToString("dd/MM HH:mm")
                                        @(msj.EsRespuestaAdmin ? "(Tú)" : "(Cliente)")
                                    </small>
                                </div>
                            </div>
                        }
                    }
                </div>

                @if (Model.Estado == COVAR_Tecnologia.Models.cotec_estadoTicket.Abierto)
                {
                    <div class="card-footer bg-body p-3 border-top-0">
                        <form id="chatForm" autocomplete="off" asp-action="Responder" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />

                            <div class="mb-3 position-relative">
                                <textarea id="textoMensaje" name="textoMensaje" class="form-control rounded-4 px-4 py-3 shadow-none bg-body-tertiary border-0" rows="3" placeholder="Escribe la respuesta al cliente aquí..."></textarea>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <div class="form-check form-switch">
                                    <input class="form-check-input shadow-none" type="checkbox" role="switch" name="cerrarTicket" value="true" id="checkCerrar">
                                    <label class="form-check-label text-danger fw-bold" for="checkCerrar">
                                        <i class="bi bi-x-circle-fill"></i> Marcar como resuelto
                                    </label>
                                </div>
                                <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm btn-hover-grow">
                                    Enviar <i class="bi bi-send-fill ms-1"></i>
                                </button>
                            </div>
                        </form>
                    </div>
                }
                else
                {
                    <div class="card-footer text-center border-top text-muted fw-bold p-3 bg-body">
                        <i class="bi bi-lock-fill"></i> Este ticket ha sido cerrado. Ya no admite respuestas.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js" integrity="sha384-/taWmisziXYpcfnYsumSUmNaiMvG/fF/OJOUCLnqCIYTrpOZy7WbFF6FfIxwOrfL" crossorigin="anonymous"></script>
    <script>
        var ticketId = "@Model.Id";
        var isAdmin = true;

        var connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .build();

        connection.on("ReceiveMessage", function (mensaje, fechaFormateada, sentByAdmin) {
            var chatContainer = document.getElementById("chatContainer");
            var noMsgs = document.getElementById("noMessagesText");
            if (noMsgs) noMsgs.style.display = "none";

            var isMine = sentByAdmin === isAdmin;
            var alignmentClass = isMine ? "justify-content-end" : "justify-content-start";
            var bgClass = isMine ? "bg-primary text-white text-end" : "bg-body border";
            var textClass = isMine ? "text-white-50" : "text-muted";
            var senderName = sentByAdmin ? "(Tú)" : "(Cliente)";
            var radiusStyle = isMine ? "border-radius: 1.5rem; border-bottom-right-radius: 0.25rem;" : "border-radius: 1.5rem; border-bottom-left-radius: 0.25rem;";

            var msgDiv = document.createElement("div");
            msgDiv.className = "d-flex mb-3 " + alignmentClass;
            msgDiv.innerHTML = `
                <div class="p-3 shadow-sm ` + bgClass + `" style="max-width: 80%; ` + radiusStyle + `">
                    <p class="mb-1" style="word-wrap: break-word;">` + mensaje + `</p>
                    <small class="` + textClass + `" style="font-size: 0.75rem;">
                        ` + fechaFormateada + ` ` + senderName + `
                    </small>
                </div>
            `;
            chatContainer.appendChild(msgDiv);
            chatContainer.scrollTop = chatContainer.scrollHeight;
        });

        connection.start().then(function () {
            connection.invoke("JoinTicketGroup", ticketId);
        }).catch(function (err) {
            return console.error(err.toString());
        });

        document.getElementById("chatForm")?.addEventListener("submit", function (e) {
            var checkCerrar = document.getElementById("checkCerrar");
            if (checkCerrar && checkCerrar.checked) {
                return;
            }

            e.preventDefault();
            var mensajeInput = document.getElementById("textoMensaje");
            var mensaje = mensajeInput.value.trim();

            if (mensaje) {
                connection.invoke("SendMessage", parseInt(ticketId), mensaje, isAdmin).catch(function (err) {
                    return console.error(err.toString());
                });
                mensajeInput.value = "";
            }
        });

        // Scroll to bottom on load
        var cc = document.getElementById("chatContainer");
        if(cc) cc.scrollTop = cc.scrollHeight;
    </script>
}
