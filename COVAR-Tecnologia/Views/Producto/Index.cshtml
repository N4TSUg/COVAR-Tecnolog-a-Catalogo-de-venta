@model IEnumerable<COVAR_Tecnologia.Models.cotec_producto>

@{
    ViewData["Title"] = "Inventario de Productos";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-8">
            <h2 class="text-primary">📦 Gestión de Inventario</h2>
            <p class="text-muted">Administra los productos del catálogo de COVAR Tecnología.</p>
        </div>
        <div class="col-md-4 text-end align-self-center">
            <a asp-action="Crear" class="btn btn-success btn-lg">
                <i class="bi bi-plus-circle"></i> + Nuevo Producto
            </a>
        </div>
    </div>

    <!-- Mostrar alerta de error si viene en el TempData -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <strong>⚠️ Atención:</strong> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover table-striped align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Nombre</th>
                        <th>Marca</th>
                        <th>Categoría</th>
                        <th>Precio</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                No hay productos registrados todavía. ¡Anímate a crear el primero!
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.Nombre</td>
                                <td><span class="badge bg-secondary">@item.Marca.Nombre</span></td>
                                <td>@item.Categoria.Nombre</td>
                                <td class="text-success fw-bold">@item.Precio.ToString("C")</td>
                                <td class="text-center">
                                    <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-warning btn-sm me-1">
                                        Editar
                                    </a>
                                    <button type="button" class="btn btn-outline-danger btn-sm" onclick="setEliminarId(@item.Id)" data-bs-toggle="modal" data-bs-target="#eliminarModal">
                                        Eliminar
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal de Eliminación -->
<div class="modal fade" id="eliminarModal" tabindex="-1" aria-labelledby="eliminarModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-danger text-white">
        <h5 class="modal-title" id="eliminarModalLabel">Confirmar Eliminación</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        <p>¿Estás seguro de que deseas eliminar este producto permanentemente?</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <form asp-action="EliminarConfirmado" method="post">
            <input type="hidden" id="productoIdAEliminar" name="id" value="" />
            <button type="submit" class="btn btn-danger">Sí, eliminar</button>
        </form>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    <script>
        function setEliminarId(id) {
            document.getElementById('productoIdAEliminar').value = id;
        }
    </script>
}
