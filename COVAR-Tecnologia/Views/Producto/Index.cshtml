@model IEnumerable<COVAR_Tecnologia.Models.cotec_producto>

@{
    ViewData["Title"] = "Inventario de Productos";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-8">
            <h2 class="text-primary">📦 Gestión de Inventario</h2>
            <p class="text-muted">Administra los productos del catálogo de COVAR Tecnología.</p>
        </div>
        <div class="col-md-4 text-end align-self-center">
            <a asp-action="Crear" class="btn btn-success btn-lg">
                <i class="bi bi-plus-circle"></i> + Nuevo Producto
            </a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover table-striped align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Nombre</th>
                        <th>Marca</th>
                        <th>Categoría</th>
                        <th>Precio</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                No hay productos registrados todavía. ¡Anímate a crear el primero!
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.Nombre</td>
                                <td><span class="badge bg-secondary">@item.Marca.Nombre</span></td>
                                <td>@item.Categoria.Nombre</td>
                                <td class="text-success fw-bold">@item.Precio.ToString("C")</td>
                                <td class="text-center">
                                    <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-warning btn-sm">
                                        Editar
                                    </a>
                                    <a asp-action="Eliminar" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                                        Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>